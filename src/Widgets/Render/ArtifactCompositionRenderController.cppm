void CompositionRenderController::setShowSafeMargins(bool show) {

  if (impl_->showSafeMargins_ == show) {

    return;

  }

  impl_->showSafeMargins_ = show;

  impl_->invalidateOverlayComposite();

  markRenderDirty();

}

