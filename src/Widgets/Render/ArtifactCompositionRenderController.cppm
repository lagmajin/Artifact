  layer->setMask(impl_->hoveredMaskIndex_, mask);
  impl_->markMaskEditDirty();
  impl_->publishLayerModified(layer, true);
  impl_->commitMaskEditTransaction();
  impl_->invalidateOverlayComposite();
  markRenderDirty();
